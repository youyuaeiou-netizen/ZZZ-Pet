<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DesktopPet/DesktopPet.csproj" />
    <Content Include="../../characters/ellen-flat2d/**/character.json;../../characters/ellen-flat2d/**/animations/**/*.png" Link="characters/ellen-flat2d/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyMonitorForTest" AfterTargets="Build">
    <MSBuild Projects="../../src/DesktopPet.MonitorWorker/DesktopPet.MonitorWorker.csproj" Targets="GetMonitorOutput" Properties="Configuration=$(Configuration)"><Output TaskParameter="TargetOutputs" ItemName="MonitorOutput" /></MSBuild>
    <PropertyGroup><MonitorDirectory>@(MonitorOutput->'%(RootDir)%(Directory)')</MonitorDirectory></PropertyGroup>
    <Error Condition="'$(MonitorDirectory)' == ''" Text="Worker output not resolved" />
    <ItemGroup><MonitorFiles Include="$(MonitorDirectory)/**/*" Exclude="$(MonitorDirectory)/**/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(MonitorFiles)" DestinationFiles="@(MonitorFiles->'$(TargetDir)monitor/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
