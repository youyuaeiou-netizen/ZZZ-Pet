<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The release worker shares the Pet's existing desktop runtime; debug layout stays compatible. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" Condition="'$(ShareDesktopRuntime)' == 'true'" />
    <Content Include="../../third_party/PresentMon/PresentMon.exe;../../third_party/PresentMon/LICENSE.txt;../../third_party/PresentMon/upstream.json" Link="fps/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../DesktopPet.Monitoring/DesktopPet.Monitoring.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Compile Include="../../third_party/LiteMonitor/HardwareRules.cs" Link="Upstream/HardwareRules.cs" />
  </ItemGroup>
  <Target Name="GetMonitorOutput" Returns="$(TargetPath)" />
</Project>
